# 이 파일을 복사해서 .env 로 만들고 설정 값을 채운다. .env는 절대 커밋하지 않는다.

DATABASE_URL=postgresql://auth_user:auth_pass@auth-db:5432/auth_db

JWT_SECRET=여기에-충분히-긴-랜덤-문자열
JWT_EXPIRE_MINUTES=60

# Chatwoot 대시보드 > Settings > Inboxes > (해당 인박스) > Settings > Configuration
# > Identity Validation 에서 복사한 토큰
CHATWOOT_HMAC_SECRET=여기에-webwidget-hmac-token
