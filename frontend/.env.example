# 팀 자체 인증 백엔드 주소
VITE_API_BASE_URL=http://localhost:8000

# Chatwoot 서버 주소 (팀원마다 로컬 Chatwoot를 쓰는 경우 값이 다름)
VITE_CHATWOOT_BASE_URL=http://localhost:3000

# Chatwoot 대시보드 > Settings > Inboxes > (해당 인박스) 에서 발급된 위젯 토큰
# (websiteToken은 각 로컬 Chatwoot 인스턴스마다 다르므로 공유 불가)
VITE_CHATWOOT_WEBSITE_TOKEN=여기에-website-token
