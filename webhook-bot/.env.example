# CHATWOOT_BASE_URL: Chatwoot 서버 주소
#   - webhook-bot이 Chatwoot와 같은 docker-compose 네트워크에 있으면
#     서비스명으로 (예: http://rails:3000), localhost 쓰면 안됨
CHATWOOT_BASE_URL=http://rails:3000
CHATWOOT_ACCOUNT_ID=1

# Chatwoot 프로필 아이콘 > Profile Settings > Access Token
# (메시지 전송/상태 변경 API 호출용, Agent Bot 자체 토큰도 가능)
CHATWOOT_API_ACCESS_TOKEN=여기에-application-api-토큰

# Settings > Bots 에서 봇 생성 시 발급되는 secret
AGENT_BOT_WEBHOOK_SECRET=여기에-내-webhook-secret
